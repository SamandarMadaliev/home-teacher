APP_NAME="Home Teacher"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production HTTPS — required when TLS terminates at Traefik/nginx/Caddy:
# APP_URL=https://ht.188.245.207.173.nip.io
# FORCE_HTTPS=true
# SESSION_SECURE_COOKIE=true
# Do NOT set VITE_DEV_SERVER_URL in production (dev-only; causes mixed content).

# Google OAuth (Socialite) — redirect must match Google Cloud console
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For SQLite, DB_DATABASE may be omitted (defaults to database/database.sqlite)
# DB_DATABASE=/absolute/path/to/database.sqlite

# PostgreSQL example:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=home_teacher
# DB_USERNAME=your_user
# DB_PASSWORD=

# Absolute path to folder containing video files (paths in DB are relative to this)
# COURSE_VIDEOS_PATH=/path/to/your/videos
# Leave empty to browse the whole PC (all drives on Windows, / on Mac/Linux). Set to limit:
# COURSE_BROWSE_ROOTS=/Users/you,/Volumes

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
